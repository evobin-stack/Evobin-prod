# MongoDB Connection String (MongoDB Atlas or local instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/evobin_db?retryWrites=true&w=majority
DB_NAME=evobin_db

# Security & JWT Configuration
JWT_SECRET=your_secure_random_jwt_secret_here
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Optional Admin Credential Overrides for Database Seeding
ADMIN_EMAIL=admin@ewaste.com
ADMIN_PASSWORD=admin123
